"""
You can use slurm_nodes to change the state of a node with an optional
reference to a ticket number. Data is retrieved from and changes are sent
to the Slurm REST API (slurmrestd).
"""

import argparse
import http.client
import itertools
import json
import os
import re
import socket
import sys
import time
from types import SimpleNamespace
from urllib.parse import quote, urlparse

SNODES_VERSION = "2.0.0 (slurmrestd)"

# Lengths to truncate columns
TRUNC = {"REASON": 23, "TICKET": 9, "NODELIST": 58}

# States to show in overview
# NOTE: these are the node state names used by Slurm (and slurmrestd)
DOWN_STATES = {
    "DOWN",
    "DRAIN",
    "ERROR",
    "INVALID_REG",
    "FAIL",
    "FAILING",
    "FUTURE",
    "MAINTENANCE",
    "NOT_RESPONDING",
    "REBOOT_ISSUED",
    "REBOOT_REQUESTED",
    "RESERVED",
    "UNKNOWN",
}

# slurmrestd connection settings. Can be set in the (smon) configuration
# file, overridden by the environment (SLURMRESTD_URL, SLURM_JWT) and the
# command line (--url, --api-version).
