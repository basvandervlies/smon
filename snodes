    #   http://host:6820   https://proxy/slurmrestd   unix:/run/slurmrestd/slurmrestd.socket
    "SLURMRESTD_URL": "http://localhost:6820",
    # empty -> use the newest version offered by slurmrestd
    "SLURMRESTD_API_VERSION": "",
    # user to act as with a root/SlurmUser JWT; empty -> the user in the token
    "SLURMRESTD_USER": "",
    "SLURMRESTD_TIMEOUT": 30,
}

# data_parser versions this program understands, newest first. The fields
# snodes uses are the same in all of them.
API_VERSIONS = ["v0.0.45", "v0.0.44", "v0.0.43", "v0.0.42", "v0.0.41", "v0.0.40"]

# Global variables set by input arguments
ARGS_QUIET = False
ARGS_DEBUG = False
ARGS_VERBOSE = False
ARGS_IGNORE = False
ARGS_DRYRUN = False
ARGS_EXPAND = False
ARGS_LONG = False

# slurmrestd client, set in __main__
CLIENT = None


class SlurmRestError(Exception):
    pass


class _UnixHTTPConnection(http.client.HTTPConnection):
    """HTTPConnection over a UNIX socket (slurmrestd local authentication)"""

    def __init__(self, path, timeout):
        super().__init__("localhost", timeout=timeout)
        self.socket_path = path

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(self.socket_path)


class SlurmRestClient:
    """Minimal slurmrestd client (standard library only)"""

    def __init__(self, url, version="", user="", token=None, timeout=30):
        self.url = url
        self.version = version or None
        self.timeout = timeout
        parsed = urlparse(url)
        self.scheme = parsed.scheme
        if self.scheme == "unix":
            self.socket_path = parsed.path
            self.prefix = ""
        elif self.scheme in ("http", "https"):
            self.host = parsed.hostname
            self.port = parsed.port
            # allows a proxy that serves slurmrestd under a sub path
            self.prefix = parsed.path.rstrip("/")
        else:
            raise SlurmRestError(f"unsupported slurmrestd URL: {url}")

        self.headers = {"Accept": "application/json"}
        if token:
            self.headers["X-SLURM-USER-TOKEN"] = token
            # Without a user name slurmctld takes the user from the token. It is
            # only needed when a root/SlurmUser token acts on behalf of a user.
            if user:
                self.headers["X-SLURM-USER-NAME"] = user
        elif self.scheme != "unix":
            raise SlurmRestError("no JWT found, set SLURM_JWT, e.g.: export $(scontrol token lifespan=3600)")

    def _connection(self):
        if self.scheme == "unix":
            return _UnixHTTPConnection(self.socket_path, self.timeout)
        if self.scheme == "https":
            return http.client.HTTPSConnection(self.host, self.port, timeout=self.timeout)
        return http.client.HTTPConnection(self.host, self.port, timeout=self.timeout)

    def _request(self, method, path, body=None):
        headers = dict(self.headers)
        payload = None
        if body is not None:
            payload = json.dumps(body).encode()
            headers["Content-Type"] = "application/json"
        if ARGS_DEBUG:
            print(f"slurmrestd: {method} {path} {payload.decode() if payload else ''}", file=sys.stderr)

        conn = self._connection()
        try:
            conn.request(method, self.prefix + path, body=payload, headers=headers)
            resp = conn.getresponse()
            raw = resp.read()
        except OSError as err:
            raise SlurmRestError(f"cannot connect to slurmrestd at {self.url}: {err}")
        finally:
            conn.close()

        data = None
        if raw:
            try:
                data = json.loads(raw)
            except ValueError:
                pass
        return resp.status, data, raw

    @staticmethod
    def _errors(data):
        if not isinstance(data, dict):
            return ""
        msgs = []
        for err in data.get("errors") or []:
            if not isinstance(err, dict):
                msgs.append(str(err))
                continue
            # description: what slurmrestd tried, error: the Slurm error string
            parts = [p for p in (err.get("description"), err.get("error")) if p]
            msg = ": ".join(dict.fromkeys(parts)) or str(err)
            if err.get("error_number"):
                msg += f" (slurm error {err['error_number']})"
            msgs.append(msg)
        return "; ".join(msgs)

    def _check(self, method, endpoint, status, data, raw):
        if status in (401, 403, 511):
            raise SlurmRestError(
                f"authentication failed (HTTP {status}) {self._errors(data)}".strip()
                + " (expired token, token for another user than SLURMRESTD_USER,"
                " or slurmrestd without rest_auth/jwt?)"
            )
        if status == 404:
            raise SlurmRestError(f"{endpoint}: not found on slurmrestd at {self.url} (API {self.version})")
        if status != 200 or data is None:
            detail = self._errors(data) or raw[:200].decode(errors="replace")
            raise SlurmRestError(f"{method} {endpoint} returned HTTP {status}: {detail}")
        if self._errors(data):
            raise SlurmRestError(self._errors(data))
        return data

    def get(self, endpoint):
        """GET /slurm/<version>/<endpoint>, detecting the API version on first use"""
        if self.version:
            status, data, raw = self._request("GET", f"/slurm/{self.version}/{endpoint}")
            return self._check("GET", endpoint, status, data, raw)

        for version in API_VERSIONS:
            status, data, raw = self._request("GET", f"/slurm/{version}/{endpoint}")
            if status == 404:
                continue  # this data_parser version is not loaded, try an older one
            self.version = version
            return self._check("GET", endpoint, status, data, raw)
        raise SlurmRestError(
            f"slurmrestd at {self.url} offers none of the supported API versions ({', '.join(API_VERSIONS)})"
        )

    def post(self, endpoint, body, allow_missing=False):
        """POST /slurm/<version>/<endpoint>

        With allow_missing a 404/405 returns None instead of raising, so the
        caller can fall back to an older endpoint.
        """
        if not self.version:
            self.get("nodes")  # detect the API version
        status, data, raw = self._request("POST", f"/slurm/{self.version}/{endpoint}", body)
        if allow_missing and status in (404, 405):
            return None
        return self._check("POST", endpoint, status, data, raw)

    def update_nodes(self, names, changes):
        """Apply changes (an update_node_msg) to the given nodes"""
        names = sorted(names)
        # One request for all nodes; not available in older slurmrestd releases
        body = dict(changes, name=names)
        if self.post("nodes", body, allow_missing=True) is not None:
            return
        for name in names:
            self.post(f"node/{quote(name, safe='')}", changes)


def _number(value, default=None):
    """Unpack slurmrestd {"set": .., "infinite": .., "number": ..} objects"""
    if isinstance(value, dict):
        if value.get("set", True) and not value.get("infinite", False):
            return value.get("number", default)
        return default
    return default if value is None else value


def _expand_hostlist(hostlist):
    """Expand a Slurm hostlist, e.g. 'r1n[01-03,07],gpu[1-2]'"""
    hosts = []
    # split on commas that are not inside brackets
    for item in re.split(r",(?![^\[]*\])", hostlist or ""):
        if not item:
            continue
        choices = []
        for part in re.split(r"(\[[^\]]*\])", item):
            if part.startswith("[") and part.endswith("]"):
                values = []
                for rng in part[1:-1].split(","):
                    if "-" in rng:
                        lo, hi = rng.split("-", 1)
                        values += [str(i).zfill(len(lo)) for i in range(int(lo), int(hi) + 1)]
                    else:
                        values.append(rng)
                choices.append(values)
            elif part:
                choices.append([part])
        hosts += ["".join(c) for c in itertools.product(*choices)]
    return hosts


def _collect_hostlist(hosts):
    """Compact hostnames to a Slurm hostlist, e.g. 'r1n[01-03,07],login1'"""
    pattern = re.compile(r"^(.*?)(\d+)$")
    # zero padded widths per prefix, so r1n10 joins r1n08 and r1n09
    padded = dict()
    for host in hosts:
        m = pattern.match(host)
        if m and m.group(2).startswith("0") and len(m.group(2)) > 1:
            padded.setdefault(m.group(1), set()).add(len(m.group(2)))

    groups = dict()
    others = set()
    for host in set(hosts):
        m = pattern.match(host)
        if not m:
            others.add(host)
            continue
        prefix, digits = m.groups()
        if digits.startswith("0") and len(digits) > 1 or len(digits) in padded.get(prefix, ()):
            width = len(digits)
        else:
            width = 0
        groups.setdefault((prefix, width), set()).add(int(digits))

    parts = []
    for (prefix, width), numbers in sorted(groups.items()):
        numbers = sorted(numbers)
        if len(numbers) == 1:
            parts.append(f"{prefix}{numbers[0]:0{width}d}")
            continue
        ranges = []
        start = prev = numbers[0]
        for n in numbers[1:]:
            if n != prev + 1:
                ranges.append((start, prev))
                start = n
            prev = n
        ranges.append((start, prev))
        rng = [f"{a:0{width}d}" if a == b else f"{a:0{width}d}-{b:0{width}d}" for a, b in ranges]
        parts.append(f"{prefix}[{','.join(rng)}]")
    return ",".join(parts + sorted(others))


def expand_nodes(nodelist):
    """Expand node range expression to list of nodes"""
    try:
        # https://www.nsc.liu.se/~kent/python-hostlist/
        import hostlist

        return set(hostlist.expand_hostlist(",".join(nodelist)))
    except ImportError:
        return set(_expand_hostlist(",".join(nodelist)))


def compact_nodes(nodelist):
    """Compact list of individual nodes to single host range expression"""
    nodelist = list(nodelist)
    try:
        # https://www.nsc.liu.se/~kent/python-hostlist/
        import hostlist

        return (len(nodelist), hostlist.collect_hostlist(nodelist))
    except ImportError:
        return (len(nodelist), _collect_hostlist(nodelist))


def _load_nodes():
    """Get all nodes from slurmrestd, with the attribute names snodes used before"""
    try:
        data = CLIENT.get("nodes")
    except SlurmRestError as err:
        print(f"Error: unable to get nodes from slurmrestd: {err}", file=sys.stderr)
        sys.exit(1)

    nodes = dict()
    for n in data.get("nodes", []):
        nodes[n["name"]] = SimpleNamespace(
            name=n["name"],
            # REST returns ["IDLE", "DRAIN", ...], the C API string is "IDLE+DRAIN"
            state="+".join(n.get("state") or ["UNKNOWN"]),
            partitions=n.get("partitions") or [],
            reason=n.get("reason") or None,
            reason_time=_number(n.get("reason_changed_at")) or None,
            reason_user=n.get("reason_set_by_user") or None,
        )
    return nodes


def get_exec_nodes(joblist):
    """Get nodes belonging to specified job(s)"""
    try:
        data = CLIENT.get("jobs")
    except SlurmRestError as err:
        print(f"Error: unable to get jobs from slurmrestd: {err}", file=sys.stderr)
        sys.exit(1)
    slurm_jobs = {j["job_id"]: j.get("nodes") or "" for j in data.get("jobs", [])}

    nodes = list()
    joblist = set([int(x) for x in joblist])

    nonexistent = joblist - set(slurm_jobs.keys())
    if nonexistent:
        print(
            f"Cannot find job(s) {','.join((str(x) for x in nonexistent))}",
            file=sys.stderr,
        )

    joblist = joblist - nonexistent
    for job in joblist:
        if slurm_jobs[job]:
            nodes.append(slurm_jobs[job])

    if nodes:
        return get_nodes(expand_nodes(nodes))
    return dict()


def get_nodes(hosts=set()):
    """Get and filter nodes"""
    if ARGS_DEBUG:
        print(f"func:get_nodes input:{hosts}", file=sys.stderr)

    select = bool(hosts)
    hosts = expand_nodes(hosts)

    if ARGS_DEBUG:
        print("func:get_nodes fetching node information", file=sys.stderr)

    # Get all nodes with their properties
    nodes = _load_nodes()
    selection = dict()
    for host, properties in nodes.items():
        states = set(properties.state.split("+"))
        # Select nodes that were specified by the user
        if not select:
            # Select nodes that are online but have no partition
            if not properties.partitions:
                properties.reason = "No partition"
            # Select nodes based on node state
            elif not bool(DOWN_STATES.intersection(states)):
                continue
        elif not hosts:
            break
        elif host in hosts:
            hosts.remove(host)
        else:
            continue

        selection[host] = properties

    if hosts:
        print(f"Cannot find node(s) {compact_nodes(hosts)[1]}", file=sys.stderr)

    if ARGS_DEBUG:
        print("func:get_nodes returning values", file=sys.stderr)
    return selection


def parse_properties(nodes):
    """Parse the properties into a common format that can be printed"""
    if ARGS_DEBUG:
        print(f"func:parse_properties input:{nodes}", file=sys.stderr)

    printline = list()
    if ARGS_DEBUG:
        print("func:parse_properties processing data", file=sys.stderr)

    groups = dict()
    timeformat = "%d %b %H:%M"
    now = int(time.time())

    # Sort on reason
    for host, properties in sorted(nodes.items(), key=lambda item: item[1].reason or ""):
        # Skip certain nodes in ignore mode
        if ARGS_IGNORE:
            if not properties.partitions:
                continue
            if "MAINTENANCE" in properties.state:
                continue
            if not properties.reason:
                continue

        # Create a dictionary with node properties
        props = dict()
        props["nodename"] = [host]
        props["state"] = properties.state.lower()
        props["date"] = properties.reason_time or now
        if properties.reason_user:
            props["username"] = properties.reason_user
        else:
            props["username"] = ""

        reason = properties.reason
        if reason:
            reasonstate = reason + "|" + props["state"]
        else:
            reasonstate = props["state"]

        # Add to group if reason and state combi already exists
        if reasonstate in groups and not ARGS_EXPAND:
            groups[reasonstate]["nodename"] += props["nodename"]
            if props["date"] > groups[reasonstate]["date"]:
                groups[reasonstate]["date"] = props["date"]
        else:
            # Split reason into note and ticket number
            if reason:
                note = reason.split("+")
            else:
                note = [""]

            if len(note) > 1:
                props["ticket"] = note[0]
                props["note"] = ", ".join(note[1:])
            else:
                # This is a Slurm generated reason without a ticket number
                props["ticket"] = ""
                props["note"] = note[0]

            if ARGS_EXPAND:
                props["count"] = 1
                props["nodename"] = props["nodename"][0]
                props["date"] = time.strftime(timeformat, time.localtime(props["date"]))
                printline.append(props)
            else:
                # Create group for reason and state combination
                groups[reasonstate] = props

    if not ARGS_EXPAND:
        # Add lines for node groups in proper order
        for reasonstate in groups:
            line = groups[reasonstate]
            line["count"], line["nodename"] = compact_nodes(line["nodename"])
            line["date"] = time.strftime(timeformat, time.localtime(line["date"]))
            printline.append(line)

    if ARGS_DEBUG:
        print("func:parse_properties returning values", file=sys.stderr)

    return printline


def format_strings(unformatted):
    """Format strings for printing"""
    formatted = list()
    for length, string in unformatted:
        formatted.append(f"{string:<{length}}")
    return formatted


def print_overview(hosts={}):
    """Print the default overview"""
    if ARGS_DEBUG:
        print(f"func:print_overview input:{hosts}", file=sys.stderr)

    # Set label and width for node properties
    labels = {
        "note": "REASON",
        "ticket": "TICKET",
        "username": "USER",
        "date": "MODIFIED",
        "count": "COUNT",
        "state": "STATE",
        "nodename": "NODELIST",
    }
    widths = dict()
    for prop in labels:
        widths[prop] = 0

    # Create a sorted list of nodes with non-matching nodes first
    print_list = parse_properties(hosts)

    # Stop here if there is nothing to show
    if not print_list:
        if not ARGS_QUIET:
            print("Nothing to show!")
        return

    # Determine the column widths
    for line in print_list:
        line["count"] = str(line["count"])
        for prop, label in labels.items():
            # Node count is only printed if nodes are clustered
            if prop == "count" and line[prop] == "1":
                continue
            if not ARGS_LONG and prop in ["username", "date"]:
                continue
            # Set width to full or truncated width
            proplen = len(line[prop])
            if line[prop] and proplen > widths[prop]:
                if not ARGS_LONG and label in TRUNC:
                    widths[prop] = min(proplen, TRUNC[label])
                else:
                    widths[prop] = proplen

    # Width can not be less than label length
    for prop, label in labels.items():
        if widths[prop] > 0:
            widths[prop] = max(widths[prop], len(label))

    # Print only columns that have values
    columns = []
    for prop, label in labels.items():
        if widths[prop] > 0:
            columns.append((widths[prop], label))
    print(f" {' | '.join(format_strings(columns))}")
    print(f"{'+'.join('-' * (column[0] + 2) for column in columns)}")

    # Prepare and print the node states and properties
    for line in print_list:
        line_columns = []
        for prop, label in labels.items():
            if widths[prop] > 0:
                if prop == "count":
                    line[prop] = line[prop].rjust(widths[prop])
                elif line[prop] is None:
                    line[prop] = ""
                elif not ARGS_LONG and label in TRUNC:
                    if len(line[prop]) > TRUNC[label]:
                        line[prop] = line[prop][: TRUNC[label] - 2]
                        line[prop] = line[prop] + ".."
                line_columns.append((widths[prop], line[prop]))
        print(f" {' | '.join(format_strings(line_columns))}")


def print_format(hosts={}, printformat=""):
    """Print in custom format for scripting"""
    print_list = parse_properties(hosts)

    for line in print_list:
        print(f"{printformat % line}")


class SaraNodes(object):
    """This class is used to change node states or properties"""

    def __init__(self):
        self.ticket = None

    def _get_current_notes(self, nodes):
        """Retrieve all nodes with notes and/or tickets"""
        if ARGS_DEBUG:
            print(
                f"class:SaraNodes func:_get_current_notes input:{nodes}",
                file=sys.stderr,
            )

        notes = dict()
        for node, properties in nodes.items():
            if properties.reason:
                notes[node] = properties.reason.split("+")
        return notes

    def _get_ticket(self, prev_ticket=None):
        """Check if we already have a ticket number"""
        if ARGS_DEBUG:
            print(
                f"class:SaraNodes func:_get_ticket input:{prev_ticket}",
                file=sys.stderr,
            )
        cur_ticket = "%s" % self.ticket
        if prev_ticket and cur_ticket == prev_ticket:
            return prev_ticket
        elif self.ticket is not None:
            return cur_ticket
        elif prev_ticket:
            return prev_ticket
        return ""

    def _generate_note(self, nodes, note, append):
        """Generate the note in a specific format"""
        if ARGS_DEBUG:
            print(
                f"class:SaraNodes func:_generate_note input:{nodes},{note},{append}",
                file=sys.stderr,
            )

        cur_data = self._get_current_notes(nodes)

        reasons = dict()
        for node in nodes:
            ticket = nnote = None
            # Get and update current ticket
            if node in cur_data.keys() and len(cur_data[node]) > 1:
                ticket = self._get_ticket(cur_data[node][0])
                nnote = cur_data[node][1:]
            else:
                ticket = self._get_ticket()
                nnote = []

            # Add, replace or append note
            if note is not None:
                if "+" in note:
                    print("Illegal character: '+'", file=sys.stderr)
                    exit(1)

                if not append or nnote == [""]:
                    nnote = [note]
                elif note and note.lower() not in [n.lower() for n in nnote]:
                    nnote.append(note)

            reasons[node] = "%s+%s" % (ticket, "+".join(nnote))
        return reasons

    def drain_node(self, nodes, note, append=True):
        """Change the state of node(s) to offline with a specific note"""
        if ARGS_DEBUG:
            print(
                f"class:SaraNodes func:drain_node input:{nodes},{note}",
                file=sys.stderr,
            )

        # Group the nodes by their new reason, one update per reason
        change_dict = {}
        for node, reason in self._generate_note(nodes, note, append).items():
            if reason not in change_dict:
                change_dict[reason] = (list(), {"state": ["DRAIN"], "reason": reason})
            change_dict[reason][0].append(node)

        for names, changes in change_dict.values():
            self._process(names, changes)

    def resume_node(self, nodes):
        """Clear the state on a node(s) to resume, also clear the note"""
        if ARGS_DEBUG:
            print(
                f"class:SaraNodes func:resume_node input:{nodes}",
                file=sys.stderr,
            )

        drained = self._get_current_notes(nodes)

        # Resume node if it has a reason (otherwise do nothing)
        selection = list()
        skip = list()
        for node in nodes:
            if node in drained:
                selection.append(node)
            else:
                skip.append(node)

        if skip and (ARGS_DEBUG or ARGS_VERBOSE):
            print(f"Node(s) {compact_nodes(skip)[1]} are already in an allowed state", file=sys.stderr)

        # Resume nodes
        if selection:
            self._process(selection, {"state": ["RESUME"]})

    def _process(self, names, changes):
        """This function executes the change via slurmrestd"""
        if ARGS_DEBUG:
            print(
                f"class:SaraNodes func:_process input:{names},{changes}",
                file=sys.stderr,
            )

        nodeset = compact_nodes(names)[1]
        # Execute the changes
        if not ARGS_DRYRUN:
            try:
                CLIENT.update_nodes(names, changes)
                if ARGS_VERBOSE:
                    print(f"Updated node(s) {nodeset}: {json.dumps(changes)}")
            except SlurmRestError as e:
                print(
                    f"Slurm error while updating node(s) '{nodeset}': {e}",
                    file=sys.stderr,
                )
                if CLIENT.scheme == "unix" and "X-SLURM-USER-TOKEN" not in CLIENT.headers:
                    print(
                        "Hint: with local (unix socket) authentication slurmrestd sends the update as the\n"
                        "      user slurmrestd runs as, not as you. Use a JWT of an admin user instead, e.g.:\n"
                        "      export $(scontrol token username=root lifespan=300)",
                        file=sys.stderr,
                    )
        else:
            print(f"slurmrestd update {nodeset}: {json.dumps(changes)}")


def read_conf(path, settings):
    """Read the slurmrestd settings from the (smon) YAML configuration file"""
    try:
        import yaml
    except ImportError:
        print("Error: PyYAML is needed to read a configuration file", file=sys.stderr)
        sys.exit(1)
    with open(path) as conf:
        conf_settings = yaml.safe_load(conf) or {}
    return {**settings, **{k: v for k, v in conf_settings.items() if k in settings}}


